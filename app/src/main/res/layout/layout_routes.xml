<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/searchToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingHorizontal="@dimen/common_item_padding_s">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/searchToolbarConstraintLayout">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnFetchTimetable"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:gravity="center">
                <EditText
                    android:id="@+id/routesSearchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:hint="@string/textedit_findroute_hint"
                    app:layout_constraintStart_toStartOf="@id/searchToolbarConstraintLayout"
                    app:layout_constraintTop_toTopOf="@id/searchToolbarConstraintLayout"
                    app:layout_constraintBottom_toBottomOf="@id/searchToolbarConstraintLayout" />
                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Fetch"
                    app:layout_constraintTop_toTopOf="@id/searchToolbarConstraintLayout"
                    app:layout_constraintBottom_toBottomOf="@id/searchToolbarConstraintLayout"
                    app:layout_constraintStart_toEndOf="@id/routesSearchBar"
                    android:src="@android:drawable/ic_menu_search"
                    android:padding="@dimen/route_shortname_padding_vertical"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnFetchTimetable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/button_routes_dropdown_menu"
                android:src="@android:drawable/ic_popup_sync"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toTopOf="@id/searchToolbarConstraintLayout"
                app:layout_constraintBottom_toBottomOf="@id/searchToolbarConstraintLayout"
                app:layout_constraintEnd_toEndOf="parent"
                android:padding="@dimen/route_shortname_padding_vertical"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/progressBarLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/searchToolbar"
        app:layout_constraintBottom_toTopOf="@id/pillContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center">
        <ProgressBar
            android:id="@+id/searchProgressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible"
            android:padding="@dimen/route_shortname_padding_vertical"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/pillContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/route_shortname_padding_vertical"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBarLinearLayout">

        <LinearLayout
            android:id="@+id/pillLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/icon_size_xs"
            android:paddingEnd="@dimen/icon_size_xs" />

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transportLinesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/pillContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scrollbars="vertical" />
</androidx.constraintlayout.widget.ConstraintLayout>