<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routesListStopContainer"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="@dimen/common_item_padding">
    <ImageView
        android:id="@+id/ivCurrentStopIndicator"
        android:layout_width="@dimen/stop_item_indicator_size"
        android:layout_height="@dimen/stop_item_indicator_size"
        android:src="@android:drawable/presence_online"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <TextView
        android:id="@+id/tvStopName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:hint="Bécsi út - Vörösvári út"
        android:layout_marginStart="@dimen/common_item_padding"
        app:layout_constraintStart_toEndOf="@id/ivCurrentStopIndicator"
        app:layout_goneMarginStart="@dimen/stop_item_name_gonemargin"
        app:layout_constraintTop_toTopOf="@id/ivCurrentStopIndicator"
        app:layout_constraintBottom_toBottomOf="@id/ivCurrentStopIndicator"/>

</androidx.constraintlayout.widget.ConstraintLayout>